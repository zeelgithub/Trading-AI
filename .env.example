# Copy this file to .env and fill in real values. NEVER commit .env.
# Regenerate keys in the Alpaca dashboard if they are ever exposed.

# --- Alpaca: trading credentials (held ONLY by src/execution) ---
ALPACA_API_KEY_ID=your_paper_key_here
ALPACA_API_SECRET_KEY=your_paper_secret_here
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets

# --- Alpaca: market data feed ---
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# iex (free, partial volume) or sip (paid, full consolidated tape)
ALPACA_DATA_FEED=iex

# --- Phone control via Telegram (notify layer; NOT trading creds) ---
# 1. In Telegram, message @BotFather -> /newbot -> copy the token here.
# 2. Message your new bot once, then send /start to the running listener; it
#    prints your numeric chat id. Put it (comma-separated for more than one) in
#    TELEGRAM_ALLOWED_CHAT_IDS. An EMPTY allowlist denies everyone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# TELEGRAM_API_BASE_URL=https://api.telegram.org   # override only for testing

# --- Optional: Anthropic API key ---
# Unlocks two independent, optional things -- the bot is fully functional and
# keyless without it: (1) Haiku compression calls in the trading-research MCP
# server (mcp_servers/trading_research); (2) smarter Telegram NL parsing and
# self-heal incident triage (src/agents/) -- both fall back to deterministic,
# keyless behavior (regex parser / plain incident brief) when this is unset.
ANTHROPIC_API_KEY=
# SEC EDGAR requires a descriptive User-Agent with a contact email.
SEC_USER_AGENT=trading-research-mcp/1.0 (your-email@example.com)
